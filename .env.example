# =====================================================================
# MIMIBIT Production Launch Environment Configuration
# =====================================================================

# 1. API Server Base URL (Leave empty or set to EC2/Domain URL)
# Example: https://mimibit.kr or http://16.178.74.230
VITE_API_BASE_URL=

# 2. Toss Payments (토스페이먼츠) Keys
# 테스트 모드: test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
# 실 서비스 상용 오픈 시: live_ck_... / live_sk_... 로 교체
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_...

# 3. Kakao Developers (카카오 로그인)
# developers.kakao.com -> 내 애플리케이션 -> 앱 키 -> JavaScript 키 입력
VITE_KAKAO_JAVASCRIPT_KEY=

# 4. Google Cloud Console (구글 로그인)
# console.cloud.google.com -> 사용자 인증 정보 -> OAuth 2.0 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=
